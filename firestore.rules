rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Get user document to check role
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    // Check if user has premium role
    function isPremiumUser() {
      return isAuthenticated() && getUserData(request.auth.uid).role == 'premium';
    }
    
    // Check if user is admin
    function isAdmin() {
      return isAuthenticated() && getUserData(request.auth.uid).role == 'admin';
    }
    
    // Check if user is trying to change their own role
    function isRoleChangeAttempt() {
      return request.resource.data.role != resource.data.role;
    }
    
    // ========================================
    // A. USER DATA COLLECTION
    // ========================================
    
    match /users/{userId} {
      // Read: Allow authenticated users (needed for team member display)
      allow read: if isAuthenticated();
      
      // Create: Allow if creating own document
      allow create: if isOwner(userId);
      
      // Update: Allow if user owns document AND not trying to escalate to admin
      // Allow username updates
      // ALSO allow team owner to update joinedTeamIds (for kicking members)
      // ADMIN: Allow admin to update role, isBanned, premiumExpiresAt
      // MOCK PAYMENT TESTING: Allow user to update their own premium fields
      allow update: if (isAdmin() && 
                       request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['role', 'isBanned', 'premiumExpiresAt'])) ||
                       (isOwner(userId) && 
                        (!isRoleChangeAttempt() || 
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])) &&
                        !(request.resource.data.role == 'admin' && resource.data.role != 'admin') &&
                        // Enforce team limits: Free (3), Premium (15)
                        (
                          !request.resource.data.keys().hasAny(['joinedTeamIds']) ||
                          request.resource.data.joinedTeamIds.size() <= (resource.data.role == 'premium' ? 15 : 3)
                        )) ||
                        // OR allow if a team owner is removing this user from joinedTeamIds (kicking)
                        (isAuthenticated() &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedTeamIds']) &&
                         request.resource.data.joinedTeamIds.size() == resource.data.joinedTeamIds.size() - 1) ||
                         // MOCK PAYMENT & IAP: Allow user to update premium fields
                         (isOwner(userId) &&
                          request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['role', 'premiumExpiresAt', 'purchaseId', 'productId', 
                                    'purchaseDate', 'mockPurchaseDate', 'mockPackageName', 
                                    'mockDurationMonths']) &&
                          // Only allow upgrading to premium, not to admin
                          request.resource.data.role in ['free', 'premium']) ||
                         // AUTO-DOWNGRADE: Allow user to downgrade self if premium expired
                         (isOwner(userId) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
                          request.resource.data.role == 'free' &&
                          resource.data.role == 'premium' &&
                          resource.data.premiumExpiresAt != null &&
                          resource.data.premiumExpiresAt < request.time);
      
      // Delete: Allow if user owns document
      
      // Delete: Allow if task belongs to authenticated user
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    
    // ========================================
    // B. PERSONAL TASKS COLLECTION
    // ========================================
    
    match /personal_tasks/{taskId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ========================================
    // C. TEAMS COLLECTION
    // ========================================
    
    match /teams/{teamId} {
      // Read: Allow authenticated users to query (for invite code check & join)
      // Or if user is owner/member of specific team
      allow read: if isAuthenticated();
      
      // Create: Allow if user has premium OR admin role
      allow create: if isPremiumUser() || isAdmin();
      
      // Update: Allow ONLY if user is the team owner
      // Update: Allow if owner OR if user is joining/leaving
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (
          // Ensure only memberIds field is being changed
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          (
            // Logic for Joining: New list must contain auth.uid and be larger
            (request.resource.data.memberIds.hasAll(resource.data.memberIds) && 
             request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
             request.resource.data.memberIds[request.resource.data.memberIds.size() - 1] == request.auth.uid) ||
             
            // Logic for Leaving: Old list must contain auth.uid and be larger
            (resource.data.memberIds.hasAll(request.resource.data.memberIds) && 
             resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1)
          )
        )
      );
      
      // Delete: Allow ONLY if user is the team owner
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      
    }
    
    // ========================================
    // D. TEAM ASSIGNMENTS (TOP-LEVEL COLLECTION)
    // ========================================
    
    match /team_assignments/{taskId} {
      // Helper function to get team by teamId field  
      function getTeam() {
        return get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data;
      }
      
      // Check if user is the team owner
      function isTeamOwner() {
        return isAuthenticated() && request.auth.uid == getTeam().ownerId;
      }
      
      // Check if user is assigned to this task
      function isAssignedMember() {
        return isAuthenticated() && resource.data.assignedToUid == request.auth.uid;
      }
      
      // CRITICAL: Check if user is still a member of the team
      // Users who left or were kicked cannot access/update assignments
      function isStillTeamMember() {
        return isAuthenticated() && 
               request.auth.uid in getTeam().memberIds;
      }
      
      // Check if update only modifies allowed fields for members
      function isMemberAllowedUpdate() {
        // Members can only update status and photos
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'photoBeforeBase64', 'photoAfterBase64', 'completedAt']);
      }
      
      // Read: Allow if user is team owner OR assigned member
      // For single document reads (.get()), we can check resource.data
      allow get: if isAuthenticated() && (
        isTeamOwner() || 
        isAssignedMember()
      );
      
      // List: Allow authenticated users to query (filtering happens in the query)
      allow list: if isAuthenticated();
      
      // Create: Allow ONLY if user is team owner (verify via teamId)
      allow create: if isAuthenticated() && 
                       request.auth.uid == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.ownerId;
      
      // Update: Team owner can update all, assigned members can only update specific fields
      // CRITICAL: Members must still be in team to update (prevents orphaned task updates)
      allow update: if isTeamOwner() || 
                       (isAssignedMember() && isStillTeamMember() && isMemberAllowedUpdate()) ||
                       // Allow member to mark their own assignment as viewed (if still in team)
                       (isAuthenticated() && 
                        resource.data.assignedToUid == request.auth.uid &&
                        isStillTeamMember() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedByMember'])) ||
                       // Allow member to mark assignment as late+viewed (when leaving/kicked)
                       (isAuthenticated() &&
                        resource.data.assignedToUid == request.auth.uid &&
                        isStillTeamMember() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'viewedByMember', 'lateMarkedAt']) &&
                        request.resource.data.status == 'late') ||
                       // Allow owner to mark as viewed (for both viewedByOwner and viewedByMember)
                       (isAuthenticated() &&
                        isTeamOwner() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedByOwner', 'viewedByMember']));
      
      // Delete: Allow team owner OR assigned member (for auto-cleanup)
      allow delete: if isTeamOwner() || isAssignedMember();
    }

    // ========================================
    // E. NOTIFICATIONS COLLECTION
    // ========================================

    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid; // Or allow system/cloud functions to create? For now assume client creates or user-scoped.
    }

    // Notification History Rules
    match /notification_history/{notifId} {
      allow read: if request.auth != null && 
                  resource.data.userId == request.auth.uid;
      
      // Allow create for:
      // 1. Personal tasks: user creating for themselves
      // 2. Team assignments: team owner creating for their members
      allow create: if request.auth != null &&
                    request.resource.data.keys().hasAll([
                      'userId', 'taskId', 'taskTitle', 
                      'notificationType', 'scheduledFor', 
                      'createdAt', 'shown'
                    ]) &&
                    (
                      // User creating notification for themselves
                      request.resource.data.userId == request.auth.uid ||
                      // OR Team owner creating notification for team member
                      (request.resource.data.teamId != null &&
                       request.auth.uid == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.ownerId)
                    );
      
      allow update: if request.auth != null &&
                    resource.data.userId == request.auth.uid &&
                    // Only allow updating 'shown' and 'shownAt'
                    request.resource.data.diff(resource.data)
                      .affectedKeys().hasOnly(['shown', 'shownAt']);
      
      allow delete: if request.auth != null &&
                    resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // F. NOTIFICATIONS COLLECTION
    // ========================================
    
    match /notifications/{notificationId} {
      // Read: Allow if notification is for the current user
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Create: Allow authenticated users to create notifications
      // (for team owners creating assignment notifications for members)
      allow create: if isAuthenticated() && request.resource.data.userId != null;
      
      // Update: Allow if notification belongs to user (for marking as shown)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Delete: Allow if notification belongs to user OR if auto-cleanup
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // G. NOTIFICATION HISTORY COLLECTION
    // ========================================
    
    match /notification_history/{historyId} {
      // Read: Allow if notification belongs to the current user
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // List: Allow authenticated users to query their notifications
      // Also needed for cascade delete when querying by taskId
      allow list: if isAuthenticated();
      
      // Create: Allow authenticated users to create notification history
      // (for team owners creating reminder histories for members)
      allow create: if isAuthenticated() && request.resource.data.userId != null;
      
      // Update: Allow if notification belongs to user (shouldn't be needed)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Delete: Allow if notification belongs to user
      // OR if authenticated user is deleting via taskId (cascade delete)
      // The app validates task ownership before cascade delete
      allow delete: if isAuthenticated();
    }

    // ========================================
    // H. TEAM ANALYTICS COLLECTION
    // ========================================
    
    match /team_analytics/{analyticsId} {
      // Helper to get team data
      function getAnalyticsTeam() {
        return get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data;
      }
      
      // Check if user is team owner
      function isAnalyticsTeamOwner() {
        return isAuthenticated() && request.auth.uid == getAnalyticsTeam().ownerId;
      }
      
      // Check if user is team member
      function isAnalyticsTeamMember() {
        return isAuthenticated() && request.auth.uid in getAnalyticsTeam().memberIds;
      }
      
      // Read: Allow team owners and members
      allow read: if isAuthenticated() && (isAnalyticsTeamOwner() || isAnalyticsTeamMember());
      
      // Create: Allow team owners (analytics service creates these)
      allow create: if isAuthenticated();
      
      // Update: Allow team owners and members (for updating analytics)
      allow update: if isAuthenticated() && (isAnalyticsTeamOwner() || isAnalyticsTeamMember());
      
      // Delete: Allow team owners (for cascade delete when deleting team)
      // Also allow authenticated users for cleanup
      allow delete: if isAuthenticated();
    }
  }
}
